# Deployer key for Electroneum testnet/mainnet. Prefer NOT setting this here — instead run
# `npx hardhat vars set DEPLOYER_PRIVATE_KEY` in your own terminal, which prompts for the value
# and stores it encrypted outside the repo (see `npx hardhat vars path`). This .env value is
# only a fallback for whichever one you don't set. Never commit the real .env file either way.
DEPLOYER_PRIVATE_KEY=

# RPC endpoints
NEXT_PUBLIC_ETN_TESTNET_RPC_URL=https://rpc.ankr.com/electroneum_testnet/
NEXT_PUBLIC_ETN_MAINNET_RPC_URL=

# Electroneum's own ENS-fork deployment addresses on testnet (JSON blob), used by
# scripts/deployMarketplace.js to fill in ETHRegistrarController / NameWrapper /
# BaseRegistrarImplementation / PublicResolver unless overridden below.
NEXT_PUBLIC_ETN_TESTNET_DEPLOYMENT_ADDRESSES={"ENSRegistry":"0x2466B8Ef6Bedd1b48FA7e0CdBeBc2300d913C701","UniversalResolver":"0xEe1f847de4d2DA11E46328B83d7551771D8f778c","BaseRegistrarImplementation":"0x7b787b31Ad58D563D7B3938b4bbfAB2c588624C5","ETHRegistrarController":"0x5BFb2958062Ac12d2019Ac1E69243DDbafCCc2c5","PublicResolver":"0x1B148DF21F18cFaEC68b71FBF11692F569658b3D","ReverseRegistrar":"0x470680Df59dB243409F67ec7EaC78D8e6f834047","Multicall":"0xcA11bde05977b3631167028862bE2a173976CA11","NameWrapper":"0x388f495A886644883F41a5958C11382e7c0D23F5"}

# Same, for mainnet — used by scripts/deployMarketplace.js only when run with
# --network electroneumMainnet. Verified on-chain 2026-08-06 (chain id 52014, real deployed
# bytecode, NameWrapper.registrar() cross-checks to BaseRegistrarImplementation below).
NEXT_PUBLIC_ETN_MAINNET_DEPLOYMENT_ADDRESSES={"BaseRegistrarImplementation":"0x5207496C1248BbD2AeeDd57Bde44dd9d4E9F1b59","ETHRegistrarController":"0x5cD5CEFDc5925cA6A9A38D2AA810d5aeD360b21C","PublicResolver":"0xDb4A3Abb6703232e20a118a104e7f4EbB3e2738D","NameWrapper":"0xd8F4B1A91469B05d9E0b15Cac4917Ee47b2A6f64"}

# Optional per-field overrides instead of relying on the JSON blob above
MARKETPLACE_REGISTRAR_CONTROLLER=
MARKETPLACE_NAME_WRAPPER=
MARKETPLACE_BASE_REGISTRAR=
MARKETPLACE_DEFAULT_RESOLVER=

# Wallet that receives the 20% registration brokerage fee (required)
MARKETPLACE_PROJECT_WALLET=

# How many confirmations to wait for before calling hardhat-verify after deploy
VERIFY_CONFIRMATIONS=5

# Block explorer API key, if the Electroneum testnet explorer ends up requiring one
# (Blockscout instances usually accept any placeholder value)
ELECTRONEUM_EXPLORER_API_KEY=not-required
